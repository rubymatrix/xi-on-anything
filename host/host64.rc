// host64's Windows resources: the game's icon (assets/icon.ico, made from assets/icon.icns), which
// Explorer and the taskbar show, and which SDL gives the game's window (it takes the executable's
// first icon), and the file's description (version resource 1; the numbers are winver.h's
// VOS_NT_WINDOWS32 and VFT_APP, written out so rc needs no include path). tools/build.py compiles this with rc.exe from the
// repository's root, so the icon's path is relative to it.
LANGUAGE 0x09, 0x01 // English (United States), as the string table below

1 ICON "assets\\icon.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FINAL FANTASY XI"
            VALUE "ProductName", "FFXI on Mac"
            VALUE "InternalName", "host64"
            VALUE "OriginalFilename", "host64.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
